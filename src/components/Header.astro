---
import { SiteName } from "../constants.ts";
import Kujakuya from "../assets/logos/kujakuya-horizontal.svg";

const links = [
  { href: "/posts/", label: "Writing" },
  { href: "/talks/", label: "Talks" },
  { href: "/activities/", label: "Activities" },
  { href: "/resume/", label: "Resume" },
];
const menuLinks = [{ href: "/", label: "Home" }, ...links];

const path = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const icon = (d: string) =>
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const moon = icon(
  `<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>`,
);
const sun = icon(
  `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>`,
);
---

<header
  class="site-header sticky top-0 z-10 flex items-center justify-between border-b border-line bg-surface px-6 py-[18px] md:px-[72px] md:py-7"
>
  <a
    href="/"
    class="font-mono text-[15px] tracking-[0.6px] no-underline hover:no-underline"
  >
    {SiteName}
  </a>
  <nav class="hidden items-center gap-9 md:flex" aria-label="Main">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          class="font-serif text-xl font-semibold italic no-underline hover:underline"
          aria-current={isCurrent(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
    <button
      type="button"
      class="theme-toggle plain-button grid size-8 place-items-center text-ink-2 hover:text-ink"
      data-theme-toggle
      aria-label="Toggle dark mode"
    >
      <span class="icon-moon"><Fragment set:html={moon} /></span>
      <span class="icon-sun"><Fragment set:html={sun} /></span>
    </button>
  </nav>
  <button
    type="button"
    popovertarget="site-menu"
    class="plain-button h-11 pl-3 font-serif text-xl font-bold italic md:hidden"
  >
    Menu
  </button>
</header>

<div id="site-menu" popover class="site-menu bg-surface text-ink">
  <div class="flex h-full flex-col">
    <div
      class="flex items-center justify-between border-b border-line px-6 py-[18px]"
    >
      <a
        href="/"
        class="font-mono text-[15px] tracking-[0.6px] no-underline hover:no-underline"
      >
        {SiteName}
      </a>
      <button
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        class="plain-button h-11 pl-3 font-serif text-xl font-bold italic"
      >
        Close
      </button>
    </div>
    <div class="flex flex-1 flex-col justify-between px-6 pt-4 pb-8">
      <nav aria-label="Main">
        <ul class="m-0 list-none p-0">
          {
            menuLinks.map(({ href, label }) => (
              <li class="border-b border-line">
                <a
                  href={href}
                  class:list={[
                    "block py-[18px] text-center font-serif text-4xl font-semibold no-underline",
                    { italic: isCurrent(href) },
                  ]}
                  aria-current={isCurrent(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex flex-col items-center gap-5">
        <div class="flex items-center gap-3" role="group" aria-label="Theme">
          <button
            type="button"
            class="theme-choice plain-button font-serif text-[22px] leading-none font-bold italic"
            data-theme-choice="light"
          >
            Light
          </button>
          <span class="mx-1 mt-1 block h-[13px] w-px bg-bar" aria-hidden="true"
          ></span>
          <button
            type="button"
            class="theme-choice plain-button font-serif text-[22px] leading-none font-bold italic"
            data-theme-choice="dark"
          >
            Dark
          </button>
        </div>
        <a
          href="mailto:me@p3ac0ck.net"
          class="font-sans text-[15px] font-medium no-underline"
        >
          me@p3ac0ck.net
        </a>
        <Kujakuya class="h-[59px] w-auto" role="img" aria-label="Kujaku-ya" />
      </div>
    </div>
  </div>
</div>

<script>
  const setTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  };
  document
    .querySelector("[data-theme-toggle]")
    ?.addEventListener("click", () =>
      setTheme(
        document.documentElement.dataset.theme === "dark" ? "light" : "dark",
      ),
    );
  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-theme-choice]",
  )) {
    button.addEventListener("click", () =>
      setTheme(button.dataset.themeChoice!),
    );
  }
</script>

<style>
  .plain-button {
    padding-block: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle {
    color: var(--sp-ink-2);
  }
  .theme-toggle:hover {
    color: var(--sp-ink);
  }
  .icon-sun,
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: contents;
  }
  .icon-moon {
    display: contents;
  }
  /* The theme that is not active reads as a link. */
  .theme-choice {
    color: var(--sp-ink-2);
  }
  :global(:root:not([data-theme="dark"]))
    .theme-choice[data-theme-choice="light"],
  :global([data-theme="dark"]) .theme-choice[data-theme-choice="dark"] {
    color: var(--sp-ink);
  }
  .site-menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
</style>
