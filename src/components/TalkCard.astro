---
import Icon from "./Icon.astro";
import Phrases from "./Phrases.astro";

interface Props {
  title: string;
  date: string;
  event: string;
  slug: string;
  video?: string;
}

const { title, date, event, slug, video } = Astro.props;

const url = `https://slides.p3ac0ck.net/${slug}`;
const image = `${url}/cover.png`;
---

<li
  class="flex flex-col gap-4 border-t border-line py-6 first:border-t-0 first:pt-0 last:pb-0 sm:flex-row sm:gap-7"
  id={slug}
>
  <a
    href={url}
    class="relative block aspect-[16/9] w-full flex-none overflow-hidden rounded border border-line bg-surface-2 sm:h-[126px] sm:w-[224px]"
    aria-label={`Slides: ${title}`}
  >
    <span
      class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 text-ink-2"
      aria-hidden="true"
    >
      <Icon name="co_present" size={24} />
      <span class="font-serif text-lg font-semibold italic">Slides</span>
    </span>
    <img
      class="relative block h-full w-full object-cover"
      src={image}
      alt=""
      loading="lazy"
      onerror="this.remove()"
    />
  </a>
  <div class="flex min-w-0 flex-col gap-2">
    <h2 class="talk-title m-0 text-[22px] leading-[1.5] font-semibold">
      <a href={url} class="no-underline hover:underline"
        ><Phrases text={title} /></a
      >
    </h2>
    <p class="m-0 flex flex-wrap items-center gap-x-2.5 text-ink-2">
      <time datetime={date} class="font-serif text-2xl font-bold italic">
        {date.replaceAll("-", ".")}
      </time>
      <span
        class="font-serif text-2xl font-medium text-line italic"
        aria-hidden="true">/</span
      >
      <span class="text-base font-medium">{event}</span>
    </p>
    {
      video && (
        <a
          href={video}
          class="flex items-center gap-1.5 self-start pt-1 font-serif text-[22px] font-bold italic no-underline hover:underline"
        >
          <Icon name="play_circle" size={20} />
          Video
        </a>
      )
    }
  </div>
</li>

<style>
  .talk-title {
    /* The emoji fallback keeps symbols like ❄ monochrome. */
    font-family: var(--font-shippori), var(--font-noto-emoji);
  }
</style>
