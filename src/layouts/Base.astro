---
import { Font } from "astro:assets";
import { SiteName } from "../constants";

const { title, lang } = Astro.props;
const ogImage = Astro.props.ogImage || `${Astro.site}og.png`;
---

<html lang={lang || "ja"}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image" href="/favicon.jpg" />
    <script
      is:inline
      async
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-258HNLC5SL"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-258HNLC5SL");
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={Astro.props.description || ""} />
    <meta property="og:url" content=`${Astro.site}${Astro.props.slug || ""}` />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={Astro.props.description || ""} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={Astro.site} />
    <meta
      property="twitter:url"
      content=`${Astro.site}${Astro.props.slug || ""}`
    />
    <meta property="twitter:title" content={title} />
    <meta
      property="twitter:description"
      content={Astro.props.description || ""}
    />
    <meta property="twitter:image" content={ogImage} />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-karla" />
    <Font cssVariable="--font-fragment-mono" />
    <Font cssVariable="--font-shippori" />
    <Font cssVariable="--font-zen-kaku" />
    <Font cssVariable="--font-noto-emoji" />
    <slot name="head" />
    <title>{title} - {SiteName}</title>
  </head>
  <body
    class="m-0 flex min-h-dvh flex-col bg-surface font-sans-jp text-ink antialiased"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* Keep anchor targets (TOC, footnotes) clear of the sticky header. */
  html {
    scroll-padding-top: 104px;
  }
  html:lang(en) body,
  html:lang(hu) body {
    font-family: var(--font-karla);
  }
  /* `body a` outranks the UnoCSS reset (`a { text-decoration: inherit }`), whose
     order relative to this sheet differs between dev and build. */
  body a {
    color: inherit;
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  /* `no-underline` uses the `text-decoration` shorthand, which resets the
     thickness; restore it for links that underline on hover. */
  body a.no-underline {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  body a:hover {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }
  ::selection {
    background-color: #f1f5f1;
  }
  @media print {
    .site-header,
    .site-footer {
      display: none;
    }
  }
</style>
