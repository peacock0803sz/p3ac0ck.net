---
import "../styles/markdown.css";
import Default from "./Default.astro";
import PageHeader from "../components/PageHeader.astro";
import LangSwitcher, {
  type Lang,
  type LangItem,
} from "../components/LangSwitcher.astro";

const { frontmatter } = Astro.props;
const lang: Lang = frontmatter.lang ?? "ja";

// Translations live next to the page as "<name>.<lang>.md" (e.g. activities.en.md);
// the switcher appears once at least one exists.
const pages = Object.keys(import.meta.glob("../pages/*.md"));
const name = Astro.url.pathname.split("/").filter(Boolean)[0]?.split(".")[0];
const translations: LangItem[] = [
  { lang: "ja", href: `/${name}/` },
  ...(["en", "hu"] as const)
    .filter((l) => pages.includes(`../pages/${name}.${l}.md`))
    .map((l) => ({ lang: l, href: `/${name}.${l}/` })),
];
---

<Default title={frontmatter.title} lang={lang}>
  <PageHeader title={frontmatter.title} rule>
    {
      translations.length > 1 && (
        <LangSwitcher items={translations} current={lang} />
      )
    }
  </PageHeader>
  <div class="px-6 pb-20 md:px-[72px]">
    <article class="markdown-body mx-auto max-w-[720px]">
      <slot />
    </article>
  </div>
</Default>
