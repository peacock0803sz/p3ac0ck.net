---
import TalkCard from "../components/TalkCard.astro";
import Default from "../layouts/Default.astro";
import PageHeader from "../components/PageHeader.astro";
import { getTalks } from "../utils/talks";

const title = "My Talk Experiences / 登壇実績";
const talks = await getTalks();
---

<Default
  title={title}
  lang="ja"
  description="カンファレンス登壇・LTの記録とスライド"
>
  <PageHeader title={title} rule />
  <div class="px-6 pb-16 md:px-[72px]">
    <div class="mx-auto flex max-w-[720px] flex-col gap-10">
      <p class="m-0 text-base leading-[1.8] text-ink-2">
        All Slides are also licensed under CC BY 4.0.
      </p>
      <ul class="m-0 list-none p-0">
        {talks.map((talk) => <TalkCard {...talk} />)}
      </ul>
    </div>
  </div>
</Default>
