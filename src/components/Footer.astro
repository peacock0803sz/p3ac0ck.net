---
import License from "./License.astro";
import Kujakuya from "../assets/logos/kujakuya-horizontal.svg";

interface Props {
  /** Hide the seal image when the page already shows a larger one (TOP). */
  seal?: boolean;
}

const { seal = true } = Astro.props;
---

<footer class="site-footer px-6 pt-4 pb-8 md:px-[72px]">
  <div
    class="flex flex-col items-center gap-2 border-t border-line pt-5 text-center md:flex-row md:items-end md:justify-between md:text-left"
  >
    <License />
    <div class="flex flex-col items-center gap-1 md:items-end">
      {
        seal && (
          <Kujakuya
            class="hidden h-12 w-auto md:block"
            role="img"
            aria-label="Kujaku-ya"
          />
        )
      }
      <p class="m-0 font-serif text-base font-semibold italic md:text-[17px]">
        Studio Peacock — Kujaku-ya
      </p>
    </div>
  </div>
</footer>
