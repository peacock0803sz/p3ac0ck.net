---
interface Props {
  title: string;
  date: string;
  event: string;
  slug: string;
  video?: string;
}

const { title, date, event, slug, video } = Astro.props;

const url = `https://slides.p3ac0ck.net/${slug}`;
const image = `${url}/cover.png`;
---

<li
  class="flex flex-col gap-4 border-t border-line py-6 first:border-t-0 first:pt-0 last:pb-0 sm:flex-row sm:gap-7"
  id={slug}
>
  <a
    href={url}
    class="relative block aspect-[16/9] w-full flex-none overflow-hidden rounded border border-line bg-surface-2 sm:h-[126px] sm:w-[224px]"
    aria-label={`Slides: ${title}`}
  >
    <span
      class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 text-ink-2"
      aria-hidden="true"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M2 3h20"></path><path
          d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path><path
          d="m7 21 5-5 5 5"></path></svg
      >
      <span class="font-serif text-lg font-medium italic">Slides</span>
    </span>
    <img
      class="relative block h-full w-full object-cover"
      src={image}
      alt=""
      loading="lazy"
      onerror="this.remove()"
    />
  </a>
  <div class="flex min-w-0 flex-col gap-2">
    <h2 class="talk-title m-0 text-[21px] leading-[1.5] font-medium">
      <a href={url} class="no-underline hover:underline">{title}</a>
    </h2>
    <p class="m-0 flex flex-wrap items-center gap-x-2.5 text-ink-2">
      <time datetime={date} class="font-serif text-xl font-medium italic">
        {date.replaceAll("-", ".")}
      </time>
      <span class="font-serif text-xl text-line italic" aria-hidden="true"
        >/</span
      >
      <span class="text-[15px]">{event}</span>
    </p>
    {
      video && (
        <a
          href={video}
          class="flex items-center gap-1.5 self-start pt-1 font-serif text-xl font-medium italic no-underline hover:underline"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 3l14 9-14 9V3z" />
          </svg>
          Video
        </a>
      )
    }
  </div>
</li>

<style>
  .talk-title {
    /* The emoji fallback keeps symbols like ❄ monochrome. */
    font-family: var(--font-shippori), var(--font-noto-emoji);
  }
</style>
