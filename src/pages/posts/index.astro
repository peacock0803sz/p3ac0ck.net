---
import { getCollection } from "astro:content";

import { format, compareDesc } from "date-fns";

import Default from "../../layouts/Default.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";

interface Entry {
  title: string;
  href: string;
  lang: "en" | "ja";
  pubDate: Date;
  emoji?: string;
  /** Host name of an article published on another site. */
  source?: string;
}

const title = "記事一覧";
const posts: Entry[] = (await getCollection("posts")).map((p) => ({
  title: p.data.title,
  href: `/posts/${p.id}/`,
  lang: p.data.lang,
  pubDate: p.data.pubDate,
  emoji: p.data.emoji,
}));
const externalPosts: Entry[] = (await getCollection("externalPosts")).map(
  (p) => ({
    title: p.data.title,
    href: p.data.slug,
    lang: p.data.lang,
    pubDate: p.data.pubDate,
    source: new URL(p.data.slug).hostname.replace(/^www\./, ""),
  }),
);

const byYear = Map.groupBy(
  [...posts, ...externalPosts].sort((a, b) =>
    compareDesc(a.pubDate, b.pubDate),
  ),
  (p) => p.pubDate.getFullYear(),
);
---

<Default
  title="Writing - Peacock (Yoichi Takai)"
  description="Peacockが執筆した記事の一覧"
>
  <PageHeader title={title} rule />
  <div class="px-6 pb-16 md:px-[72px]">
    <div class="mx-auto flex max-w-[720px] flex-col gap-12">
      {
        [...byYear].map(([year, entries]) => (
          <section>
            <h2 class="m-0 font-serif text-[34px] leading-[1.2] font-semibold italic">
              {year}
            </h2>
            <ul class="m-0 list-none p-0 pt-2">
              {entries.map((p) => (
                <li class="flex gap-4 border-b border-line py-3.5">
                  <time
                    datetime={format(p.pubDate, "yyyy-MM-dd")}
                    class="w-[66px] flex-none font-serif text-[26px] leading-[1.11] font-bold text-ink-2 italic"
                  >
                    {format(p.pubDate, "MM.dd")}
                  </time>
                  {p.source ? (
                    <>
                      <span class="flex h-[28.6px] w-[26px] flex-none items-center justify-center text-ink-2">
                        <Icon name="north_east" size={20} />
                      </span>
                      <div class="flex min-w-0 flex-col gap-0.5">
                        <a
                          href={p.href}
                          class="text-[17px] leading-[1.7] no-underline hover:underline"
                          lang={p.lang}
                        >
                          {p.title}
                        </a>
                        <span class="font-sans text-[13px] leading-[1.4] text-ink-2">
                          <span class="sr-only">外部サイト: </span>
                          {p.source}
                        </span>
                      </div>
                    </>
                  ) : (
                    <>
                      <span
                        class="flex h-[28.6px] w-[26px] flex-none items-center justify-center font-emoji text-xl"
                        aria-hidden="true"
                      >
                        {p.emoji}
                      </span>
                      <a
                        href={p.href}
                        class="text-[17px] leading-[1.7] no-underline hover:underline"
                        lang={p.lang}
                      >
                        {p.title}
                      </a>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Default>
