---
import { Font } from "astro:assets";
import { SiteDescription, SiteName } from "../constants";
import "../styles/theme.css";

interface Props {
  title: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  /** Marks the page as an article (posts) for og:type and its publish date. */
  publishedTime?: Date;
}

const { title, lang = "ja", publishedTime } = Astro.props;
const description = Astro.props.description || SiteDescription;
const ogImage = Astro.props.ogImage || new URL("/og.png", Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const locales: Record<string, string> = {
  ja: "ja_JP",
  en: "en_US",
  hu: "hu_HU",
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the theme before first paint: a saved choice wins, otherwise follow the OS.
      (() => {
        const media = matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          let saved = null;
          try {
            saved = localStorage.getItem("theme");
          } catch {}
          document.documentElement.dataset.theme =
            saved ?? (media.matches ? "dark" : "light");
        };
        apply();
        media.addEventListener("change", apply);
      })();
    </script>
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <script
      is:inline
      async
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-258HNLC5SL"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-258HNLC5SL");
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SiteName}
      href={new URL("/rss.xml", Astro.site)}
    />
    <meta property="og:site_name" content={SiteName} />
    <meta property="og:locale" content={locales[lang] ?? "ja_JP"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@peacock0803sz" />
    <meta property="twitter:domain" content={new URL(Astro.site!).host} />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-karla" />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-shippori" />
    <Font cssVariable="--font-zen-kaku" />
    <Font cssVariable="--font-noto-emoji" />
    <Font cssVariable="--font-icons" preload />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body
    class="m-0 flex min-h-dvh flex-col bg-surface font-sans-jp text-ink antialiased"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* Keep anchor targets (TOC, footnotes) clear of the sticky header. */
  html {
    scroll-padding-top: 104px;
  }
  html:lang(en) body,
  html:lang(hu) body {
    font-family: var(--font-karla);
  }
  /* `body a` outranks the UnoCSS reset (`a { text-decoration: inherit }`), whose
     order relative to this sheet differs between dev and build. */
  body a {
    color: inherit;
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  /* `no-underline` uses the `text-decoration` shorthand, which resets the
     thickness; restore it for links that underline on hover. */
  body a.no-underline {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  body a:hover {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }
  ::selection {
    background-color: var(--sp-surface-2);
  }
  @media print {
    .site-header,
    .site-footer {
      display: none;
    }
  }
</style>
